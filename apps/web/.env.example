# Leave empty for same-origin API calls:
# - local: Vite proxies /api and /health to http://127.0.0.1:8787
# - Vercel: rewrites /api and /health to the serverless control plane
# VITE_ERASEGRAPH_API_URL=

# Leave unset for the built-in same-origin /trueforge proxy. Set only when your host enables CORS.
# VITE_TRUEFORGE_URL=http://127.0.0.1:8790
